# Docker Compose 项目
COMPOSE_PROJECT_NAME=sku-table
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443

# 访问域名（备案通过后填写，如 sku.example.com）
# 未填写时允许通过服务器 IP 直接访问；填写后仅该域名可访问，IP 直访返回 444
APP_DOMAIN=sku.iboluo.top

# Let’s Encrypt 证书和 HTTP-01 验证目录（服务器宿主机路径）
LETSENCRYPT_DIR=/etc/letsencrypt
ACME_WEBROOT_DIR=/opt/sku-table/state/acme

# PostgreSQL
POSTGRES_DB=sku_table
POSTGRES_USER=sku_table
POSTGRES_PASSWORD=replace-with-a-strong-password

# API
# 密码包含特殊字符时，需先进行 URL 编码。
DATABASE_URL=postgresql://sku_table:replace-with-a-strong-password@postgres:5432/sku_table
JWT_SECRET=replace-with-at-least-32-random-characters

# COS 数据库备份（凭据只写入服务器 state/.env，权限仅限本桶对象上传和校验）
COS_BUCKET=sku-table-backups-1321149166
COS_REGION=ap-guangzhou
COS_PREFIX=postgres
COS_SECRET_ID=
COS_SECRET_KEY=
BACKUP_STAGING_DIR=/opt/sku-table/state/backup-staging
