# Docker Compose 项目
COMPOSE_PROJECT_NAME=sku-table
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80

# PostgreSQL
POSTGRES_DB=sku_table
POSTGRES_USER=sku_table
POSTGRES_PASSWORD=replace-with-a-strong-password

# API
# 密码包含特殊字符时，需先进行 URL 编码。
DATABASE_URL=postgresql://sku_table:replace-with-a-strong-password@postgres:5432/sku_table
JWT_SECRET=replace-with-at-least-32-random-characters
