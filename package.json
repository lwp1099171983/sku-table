{
  "name": "sku-table-workspace",
  "private": true,
  "version": "0.1.13",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @sku-table/web dev",
    "dev:api": "pnpm --filter @sku-table/api dev",
    "build": "pnpm build:shared && pnpm build:web && pnpm build:api",
    "build:shared": "pnpm --filter @sku-table/shared build",
    "build:web": "pnpm --filter @sku-table/web build",
    "build:api": "pnpm --filter @sku-table/api build",
    "test": "pnpm build:shared && pnpm --filter @sku-table/api test",
    "typecheck": "pnpm build:shared && pnpm typecheck:web && pnpm typecheck:api",
    "typecheck:shared": "pnpm --filter @sku-table/shared typecheck",
    "typecheck:web": "pnpm --filter @sku-table/web typecheck",
    "typecheck:api": "pnpm --filter @sku-table/api typecheck",
    "db:migrate": "pnpm --filter @sku-table/api db:migrate",
    "db:seed": "pnpm --filter @sku-table/api db:seed",
    "db:local:up": "docker compose --env-file infra/docker/.env.local -f infra/docker/docker-compose.local.yml up -d",
    "db:local:down": "docker compose --env-file infra/docker/.env.local -f infra/docker/docker-compose.local.yml down",
    "db:local:logs": "docker compose --env-file infra/docker/.env.local -f infra/docker/docker-compose.local.yml logs -f postgres",
    "db:local:psql": "docker compose --env-file infra/docker/.env.local -f infra/docker/docker-compose.local.yml exec postgres psql -U sku_table -d sku_table"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  }
}
