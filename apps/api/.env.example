NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://sku_table:change-me@127.0.0.1:5432/sku_table
JWT_SECRET=change-me-with-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=604800

# 执行 pnpm db:seed 时使用，不提交真实密码。
SEED_USER_EMAIL=owner@example.com
SEED_USER_PASSWORD=change-me
SEED_STUDIO_NAME=默认工作室
